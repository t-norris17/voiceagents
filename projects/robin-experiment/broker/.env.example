# Broker environment (set in Vercel project settings — NEVER commit real values).
# Supabase: service role key is server-only. Do NOT expose to the browser or the agent.
SUPABASE_URL=https://rlhybqslnqhggbykjrqg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs post-call webhook signing secret (Developers -> Webhooks).
ELEVENLABS_WEBHOOK_SECRET=

# Anthropic API key — powers the Phase-1 Q&A test tool (/api/ask + the / page) and the call grader
# (/api/grade). Not needed by verify_caller / get_balance / postcall.
ANTHROPIC_API_KEY=

# ElevenLabs API key (Developers -> API Keys). The grader reads the text of the KB documents Robin
# actually retrieved, via GET /v1/convai/knowledge-base/{id}/content, so it can check what she SAID
# against what she READ. Without this it can only see documents we published ourselves — anything
# uploaded in the ElevenLabs dashboard is invisible, answers grade as "no source", and there is no
# accuracy score and no utilization figure.
ELEVENLABS_API_KEY=
