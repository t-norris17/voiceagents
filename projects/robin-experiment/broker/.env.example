# Broker environment (set in Vercel project settings — NEVER commit real values).
# Supabase: service role key is server-only. Do NOT expose to the browser or the agent.
SUPABASE_URL=https://rlhybqslnqhggbykjrqg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs post-call webhook signing secret (Developers -> Webhooks).
ELEVENLABS_WEBHOOK_SECRET=

# Anthropic API key — powers the Phase-1 Q&A test tool (/api/ask + the / page).
# Not needed by verify_caller / get_balance / postcall.
ANTHROPIC_API_KEY=

# After-hours requests (Birdnest Requests). Shared secret Robin's get_handoff_option and file_request
# tools send in the x-robin-tool-secret header (from the ElevenLabs workspace secret broker_tool_secret).
# Unset = both tools answer 503 (fail closed).
REQUESTS_TOOL_SECRET=
# Optional test window: an ISO timestamp (e.g. 2026-10-06T16:00:00Z). Until then the request tools
# answer as if the call center were closed, so the after-hours path can be tested on Robin's real line
# during the day; requests filed inside it are test rows. Switches itself off at that time; a value more
# than 12 hours ahead is ignored. Leave unset normally.
REQUESTS_FORCE_CLOSED_UNTIL=
